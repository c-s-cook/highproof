<%- include('partials/header'); -%>


    <h1><%= title %></h1>
    
    <div id="voucher-tables">
        <h2>TOURS</h2>
        <p>Here's the Voucher Count for each Tour...</p>
        <table id="vouchers-count-table" class="table table-striped table-bordered table-hover" style="color:black;">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ACTIVE TITLE</th>
                    <th>AVAILABLE</th>
                    <th>TOTAL COUNT</th>
                </tr>
            </thead>
            <tbody>
                <% tours.forEach(function(tour) { %>
                    <tr>
                        <td><%= tour.TOUR_NUM %></td>
                        <td><%= tour.TITLES[0] %></td>
                        <td><%= tour.AVAILABLE %></td>
                        <td><%= tour.TOTAL %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>


        
        <h2>VOUCHERS LIST</h2>
        <p>Here's all the Vouchers...</p>
        <table id="vouchers-list-table" class="table table-striped table-bordered table-hover" style="color:black;">
            <thead>
                <tr>
                    <th>TOUR_NUM</th>
                    <th>VOUCHER_ID</th>
                    <th>AVAILABLE</th>
                    <th>LINK</th>
                    <th>TRANSACTION</th>
                </tr>
            </thead>
            <tbody>
                <% vouchers.forEach(function(voucher) { %>
                    <tr>
                        <td><%= voucher.TOUR_NUM %></td>
                        <td><%= voucher.VOUCHER_ID %></td>
                        <td><%= voucher.AVAILABLE %></td>
                        <td><%= voucher.LINK %></td>
                        <td><a href="../transactions/<%= voucher.TRANSACTION_ID %>"><%= voucher.TRANSACTION_ID %></a></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <!-- Include the DataTables JS and CSS -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css">
        <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
        <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>

        <!-- Initialize DataTable -->
        <script type="text/javascript">
            $(document).ready(function() {
                $('#vouchers-count-table').DataTable();
                $('#vouchers-list-table').DataTable();
            });
        </script>

      
    </div>

<%- include('partials/footer'); -%>
